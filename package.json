{
  "name": "edudata-uci-live",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard Pendidikan Indonesia — Live (API Indonesia) · UCI. Cloudflare Worker: halaman statis + proxy API berpengaman.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "check": "node scripts/build.mjs && wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "wrangler": "4.163.0"
  }
}
